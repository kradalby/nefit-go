# Temporary, device-scoped forwarding for the research relays. Set the defines
# to this host's LAN interface and address and the device address; the host
# must already forward LAN-to-LAN traffic. SNAT keeps replies flowing back
# through this host when the router would otherwise route them around it.
# Remove with: sudo nft delete table ip nefit_research
define lan = "eth0"
define thermostat = 192.0.2.10
define relay = 198.51.100.10

table ip nefit_research {
    chain postrouting {
        type nat hook postrouting priority 99; policy accept;
        iifname $lan oifname $lan ip saddr $thermostat counter snat to $relay
    }
    chain output {
        # A redirect would tell the device to bypass this host.
        type filter hook output priority 0; policy accept;
        ip daddr $thermostat icmp type redirect counter drop
    }
}
